# GoMeCoiffer API — modèle des variables d'environnement.
# Copier en backend/.env (jamais commité) et remplacer chaque valeur <…>.
# Générer un secret (64 octets, valable pour tous) : node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# Un secret différent par variable ; APP_ENCRYPTION_KEY : exactement 32 octets (randomBytes(32)).
# Chaque variable est validée au démarrage par le schéma Zod de config : une valeur absente ou trop faible arrête l'app.
# En preprod/prod, ces valeurs sont des variables d'environnement du serveur, jamais un fichier du dépôt.

# --- Application
NODE_ENV=development
# local | test | preprod | prod
APP_ENV=local
APP_NAME=GoMeCoiffer
PORT=10400
API_PUBLIC_URL=http://localhost:10400
# Allowlist CORS et origine attendue (SSE, CSRF) ; plusieurs origines séparées par des virgules
WEB_ORIGIN=http://localhost:10401
# Lien public envoyé aux clients (réservation, proposition de reprogrammation)
WEB_PUBLIC_URL=http://localhost:10401
LOG_LEVEL=debug
DEFAULT_SALON_TIME_ZONE=Africa/Douala
# Nombre de reverse proxys de confiance devant l'API (0 : aucun ; 1 : un répartiteur ; 2 : CDN + répartiteur).
# Fixe l'adresse réseau lue pour les limites de connexion : obligatoire hors local, à régler au déploiement.
# Les anciennes valeurs true (= 1) et false (= 0) restent acceptées.
TRUST_PROXY=0
# Documentation OpenAPI sur /api/docs ; toujours false en prod
OPENAPI_ENABLED=true

# --- PostgreSQL (écriture)
DB_HOST=127.0.0.1
DB_PORT=10402
DB_NAME=gomecoiffer
DB_USER=gomecoiffer
DB_PASSWORD=<secret-genere-au-moins-24-caracteres>
# true en preprod/prod (connexion chiffrée)
DB_SSL=false
DB_POOL_MAX=10
DB_LOGGING=false
# --- PostgreSQL (lecture, facultatif) : vide = même serveur que l'écriture
DB_READ_HOST=
DB_READ_PORT=

# --- Session et CSRF
# 64 octets aléatoires minimum, différents par environnement
SESSION_SECRET=<secret-genere-64-octets-base64>
# préfixé __Host- en prod (cookie Secure, Path=/, sans Domain)
SESSION_COOKIE_NAME=gmc.sid
SESSION_TTL_HOURS=24
# Durée absolue depuis la connexion : au-delà, reconnexion obligatoire même si la session sert sans arrêt
SESSION_MAX_AGE_HOURS=168
# Session client ouverte par code SMS : 7 jours sans activité, 30 jours au plus (D-054)
CLIENT_SESSION_TTL_HOURS=168
CLIENT_SESSION_MAX_AGE_HOURS=720
# Numéro recyclé : délai sans preuve du numéro avant nouvelle titularité (D-053)
PHONE_HOLDER_GAP_DAYS=180
# true dès que le site est servi en HTTPS (preprod, prod)
COOKIE_SECURE=false
CSRF_SECRET=<secret-genere-48-octets-base64>

# --- Jetons, OTP et liens sécurisés (stockés hachés avec ce poivre)
TOKEN_HASH_PEPPER=<secret-genere-48-octets-base64>

# --- Règles de réservation (PRD)
# BR-04 : blocage du créneau pendant le paiement en ligne
BOOKING_PAYMENT_HOLD_MINUTES=10
# F06 : validité d'une proposition de reprogrammation [HYPOTHÈSE, à valider : docs/BACKLOG.md]
RESCHEDULE_PROPOSAL_TTL_HOURS=24
# F08 : période de grâce d'un abonnement expiré [HYPOTHÈSE, à valider : docs/BACKLOG.md]
SUBSCRIPTION_GRACE_DAYS=7

# --- Chiffrement au repos (identifiants marchands des salons) : 32 octets en base64 (AES-256-GCM)
APP_ENCRYPTION_KEY=<cle-generee-32-octets-base64>

# --- Paiement Mobile Money (agrégateur à choisir, PRD §16)
# fake | <nom-de-l-agregateur>
PAYMENT_PROVIDER=fake
PAYMENT_API_BASE_URL=
PAYMENT_API_KEY=
# Secret partagé de signature des webhooks (HMAC)
PAYMENT_WEBHOOK_SECRET=<secret-genere-48-octets-base64>
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# --- SMS (OTP, liens de réservation)
# fake | <nom-du-fournisseur>
SMS_PROVIDER=fake
SMS_API_KEY=
SMS_SENDER_ID=GoMeCoiffer

# --- E-mail (Mailpit en local)
SMTP_HOST=127.0.0.1
SMTP_PORT=10404
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=GoMeCoiffer <no-reply@gomecoiffer.local>

# --- Fichiers (photo du salon)
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads
UPLOAD_MAX_BYTES=5242880

# --- Limitation de débit (valeurs globales ; les routes sensibles ont leurs propres limites)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
# Connexion (UC-002) : requêtes par heure par appareil (par adresse sans cookie d'appareil), puis par adresse seule.
SIGN_IN_RATE_LIMIT_PER_HOUR=100
SIGN_IN_ADDRESS_RATE_LIMIT_PER_HOUR=600
