{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "migration:run": "nest build && node dist/database/cli.js run",
    "migration:revert": "nest build && node dist/database/cli.js revert",
    "migration:show": "nest build && node dist/database/cli.js show",
    "migration:create": "node scripts/migration-create.mjs",
    "migration:generate": "nest build && typeorm migration:generate -d dist/database/data-source.js",
    "db:seed": "nest build && node dist/database/seed/run-seed.js",
    "platform:bootstrap-super-admin": "nest build && node dist/modules/platform/infrastructure/cli/bootstrap-super-admin.cli.js"
  },
  "dependencies": {
    "@gomecoiffer/contracts": "workspace:*",
    "@nestjs-cls/transactional": "^4.0.2",
    "@nestjs-cls/transactional-adapter-typeorm": "^2.0.2",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/cqrs": "^12.1.3",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/typeorm": "^12.0.3",
    "@node-rs/argon2": "^2.2.2",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.1.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "nestjs-cls": "^7.0.2",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/testing": "^12.5.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
