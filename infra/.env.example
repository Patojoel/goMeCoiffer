# Infrastructure locale (docker compose -f infra/compose.yml up -d).
# Copier en infra/.env (jamais commité). POSTGRES_PASSWORD doit être identique à DB_PASSWORD de backend/.env.
# Bloc de ports du projet : 10400-10409, publiés sur 127.0.0.1 uniquement.
POSTGRES_PORT=10402
POSTGRES_DB=gomecoiffer
POSTGRES_USER=gomecoiffer
POSTGRES_PASSWORD=<meme-valeur-que-DB_PASSWORD>
MAILPIT_UI_PORT=10403
MAILPIT_SMTP_PORT=10404
