{
  "name": "gomecoiffer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "pnpm -r --filter @gomecoiffer/contracts build && pnpm -r --filter api --filter web build",
    "dev": "pnpm --filter @gomecoiffer/contracts build && pnpm -r --parallel --filter api --filter web dev",
    "test": "pnpm --filter @gomecoiffer/contracts build && pnpm -r --workspace-concurrency=1 test:all",
    "lint": "oxlint backend/src frontend/src packages/contracts/src",
    "typecheck": "pnpm --filter @gomecoiffer/contracts build && pnpm -r typecheck",
    "arch": "depcruise backend/src frontend/src --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "mutation": "pnpm -r mutation"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.8.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  }
}
